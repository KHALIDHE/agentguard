# Copy to .env. Compose reads it; nothing here is committed.
ORACLE_SYS_PASSWORD=change-me
HOSPITAL_DB_PASSWORD=change-me
AGENTGUARD_DB_PASSWORD=change-me

# Gateway: signs user tokens. At least 32 random characters (openssl rand -base64 48)
JWT_SECRET=
# Shared secret between the gateway and the hospital tools. Agents never see it.
HOSPITAL_SERVICE_TOKEN=
# Password for the demo users (dr.amrani, nurse.salma, ...). Leave empty in production.
DEMO_USER_PASSWORD=

# Demo agent model provider: ollama (local) or openai
AI_PROVIDER=ollama
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
OPENAI_API_KEY=
