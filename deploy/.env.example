# Copy to deploy/.env on the server. The real .env is never committed.
# Same Oracle SYS password as the QlinkR stack (used once, to create the two users).
ORACLE_SYS_PASSWORD=
FINANCE_DB_PASSWORD=
AGENTGUARD_DB_PASSWORD=
# Signs the login tokens, at least 32 random characters
JWT_SECRET=
# Shared secret between the gateway and the finance tools
FINANCE_SERVICE_TOKEN=
# Password of the demo users
DEMO_USER_PASSWORD=
# Key for the demo agent. Set a small monthly limit at the provider.
OPENAI_API_KEY=
# Any OpenAI-compatible service. For Groq (free): https://api.groq.com/openai/v1 and openai/gpt-oss-120b
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini
# Only for Groq: AGENT_OPTIONS_JSON={"spring":{"ai":{"openai":{"chat":{"options":{"extra-body":{"include_reasoning":false}}}}}}}
MAX_CHATS_PER_HOUR=40
